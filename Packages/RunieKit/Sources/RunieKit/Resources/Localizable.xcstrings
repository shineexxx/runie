    "«%@» — встроенный навык Руни, его нельзя заменить или удалить.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is a built-in Runie skill; it can’t be replaced or deleted."
          }
        }
      }
    },
    "Агент неожиданно завершился (код %d)": {},
    "Агент неожиданно завершился (код %lld)": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The agent quit unexpectedly (code %lld)"
